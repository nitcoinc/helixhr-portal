{
 "actions": [],
 "allow_rename": 0,
 "autoname": "format:{event}-{company}",
 "creation": "2026-09-20 00:00:00.000000",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "event",
  "company",
  "is_enabled",
  "email_template",
  "recipient_mode",
  "recipients",
  "frequency",
  "hide_logo"
 ],
 "fields": [
  {
   "fieldname": "event",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Event",
   "options": "birthday\nwork_anniversary\nholiday",
   "read_only_depends_on": "eval:!doc.__islocal",
   "reqd": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Company",
   "options": "Company",
   "reqd": 1
  },
  {
   "default": "0",
   "fieldname": "is_enabled",
   "fieldtype": "Check",
   "in_list_view": 1,
   "label": "Enabled"
  },
  {
   "fieldname": "email_template",
   "fieldtype": "Link",
   "label": "Email Template",
   "options": "Email Template"
  },
  {
   "default": "All employees",
   "fieldname": "recipient_mode",
   "fieldtype": "Select",
   "label": "Recipients",
   "options": "All employees\nSelected employees",
   "reqd": 1
  },
  {
   "depends_on": "eval:doc.recipient_mode == \"Selected employees\"",
   "fieldname": "recipients",
   "fieldtype": "Table",
   "label": "Selected Employees",
   "options": "HelixHR Celebration Recipient"
  },
  {
   "depends_on": "eval:doc.event == 'holiday'",
   "description": "How often the holiday reminder goes out (holiday only): Weekly on Monday, Monthly on the 1st.",
   "fieldname": "frequency",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Frequency",
   "options": "\nWeekly\nMonthly"
  },
  {
   "default": "0",
   "description": "Leave the company logo out of this reminder's header; the company name is shown instead.",
   "fieldname": "hide_logo",
   "fieldtype": "Check",
   "label": "Hide company logo"
  }
 ],
 "module": "HelixHR",
 "name": "HelixHR Celebration Reminder",
 "naming_rule": "Expression",
 "permissions": [
  {
   "create": 1,
   "delete": 1,
   "email": 1,
   "export": 1,
   "print": 1,
   "read": 1,
   "report": 1,
   "role": "HR Manager",
   "share": 1,
   "write": 1
  },
  {
   "create": 1,
   "delete": 1,
   "email": 1,
   "export": 1,
   "print": 1,
   "read": 1,
   "report": 1,
   "role": "System Manager",
   "share": 1,
   "write": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1
}
