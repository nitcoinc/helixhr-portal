# Dependencies
node_modules/
.pnpm-store/
__pycache__/
*.py[cod]
.venv/
venv/

# Build outputs
dist/
build/
.next/
out/
*.egg-info/

# HelixHR frontend build output (generated by `cd frontend && yarn build`,
# written to these two paths by frappe-ui/vite's buildConfig plugin — see
# frontend/vite.config.js and U2 in the phase 1 plan)
helixhr/public/helixhr/
helixhr/www/helixhr.html

# unplugin-auto-import / unplugin-vue-components type declarations --
# regenerated on every dev/build run from whatever's actually imported.
frontend/auto-imports.d.ts
frontend/components.d.ts

# Playwright auth.setup.ts output (session cookies for the two test users)
frontend/tests/.auth/

# Environment — MEM0_API_KEY and friends live here, never commit them
.env
.env.*
!.env.example

# CocoIndex semantic index — large, machine-local, rebuild with `ccc index .`
.cocoindex_code/

# Agent scratch
_archive/
.claude/audit.log

# Note: .scratch/ is deliberately NOT ignored. If /to-tickets is configured for
# the local-files tracker, your tickets live in .scratch/<feature>/issues/ and
# should be committed. Ignore it only if you use a real tracker instead.

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp

# Testing
coverage/
.coverage
htmlcov/
.pytest_cache/
test-results/

# Logs
*.log
logs/

# Local-only scratch
.local/
.private/

# Impeccable working artifacts: review captures and decision logs are
# regenerated per run; the surface briefs and PRODUCT.md are durable.
.impeccable/review/
.impeccable/questions/
.impeccable/mocks/
.impeccable/build/
